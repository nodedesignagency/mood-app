# The .xcodeproj IS committed, and is generated by genproj.py rather than by
# Xcode's UI. It records which files exist, so excluding it means every file
# added on one machine has to be re-added by hand on every other. Only the
# genuinely per-user parts are ignored.
xcuserdata/
*.xcworkspace/xcuserdata/
project.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist

build/
DerivedData/
shot*.png
.DS_Store
